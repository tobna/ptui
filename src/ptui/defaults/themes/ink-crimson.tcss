/* Drop any .tcss file in themes/ and select it via [ui].theme.
   Palette is defined once at the top; widgets reference variables only. */

$ink:        #14161a;
$ink-raised: #1c1f26;
$ink-border: #2b303b;
$paper:      #d8d5cd;
$paper-dim:  #8b8b86;
$crimson:    #b8283c;
$crimson-lo: #7a1a28;
$amber:      #c08a3e;
$sage:       #6f8f6a;

Screen { background: $ink; color: $paper; }

/* ── panes ─────────────────────────────────────────────── */
#list-pane  { border: solid $ink-border; }
#info-pane  { border: solid $ink-border; background: $ink-raised; }
#files-pane { border: solid $ink-border; }
#log-pane   { border: solid $ink-border; background: $ink-raised; }

#list-pane:focus-within,
#info-pane:focus-within,
#files-pane:focus-within,
#log-pane:focus-within { border: solid $crimson; }

/* ── list ──────────────────────────────────────────────── */
DataTable > .datatable--header  { color: $paper-dim; text-style: bold; }
DataTable > .datatable--cursor  { background: $crimson-lo; color: $paper; }
DataTable > .datatable--hover   { background: $ink-raised; }

.marked         { color: $amber; text-style: bold; }
.marked-cursor  { background: $crimson-lo; color: $amber; }

.sort-active    { color: $crimson; text-style: bold; }   /* sorted column header */
.sort-arrow     { color: $crimson; }

/* ── file / doctor status ──────────────────────────────── */
.status-ok        { color: $sage; }
.status-already   { color: $paper-dim; }
.status-conflict  { color: $crimson; }
.status-duplicate { color: $amber; }
.status-unmanaged { color: $paper-dim; text-style: italic; }
.status-missing   { color: $crimson; text-style: bold; }
.status-error     { color: $crimson; text-style: bold reverse; }

/* ── reading status / rating ───────────────────────────── */
.read-unread  { color: $paper-dim; }
.read-reading { color: $amber; }
.read-read    { color: $sage; }
.rating       { color: $amber; }

/* ── status bar ────────────────────────────────────────── */
#status-bar    { background: $ink-raised; color: $paper-dim; }
#status-marks  { color: $amber; }
#status-scope  { color: $paper; }
#status-narrow { color: $crimson; }
#status-sort   { color: $paper-dim; }

/* ── prompts, pickers, modals ──────────────────────────── */
#prompt          { background: $ink-raised; border: tall $crimson; }
SelectList        { background: $ink-raised; border: tall $crimson; }
SelectList .title { color: $paper; text-style: bold; }
SelectList .current { color: $amber; text-style: bold; }
SelectList .meta    { color: $paper-dim; }
SelectList .match   { color: $crimson; text-style: bold; }

ConfirmDialog        { background: $ink-raised; border: tall $crimson; }
ConfirmDialog .count { color: $amber; text-style: bold; }
ConfirmDialog .warn  { color: $crimson; text-style: bold; }

/* ── discoverability layers ────────────────────────────── */
#which-key        { background: $ink-raised; color: $paper-dim; border: solid $ink-border; }
#which-key .key   { color: $crimson; text-style: bold; }
#which-key .desc  { color: $paper; }

#hint-bar         { background: $ink; color: $paper-dim; }
#hint-bar .key    { color: $crimson; text-style: bold; }

#help-overlay             { background: $ink-raised; border: tall $crimson; }
#help-overlay .namespace  { color: $amber; text-style: bold; }
#help-overlay .key        { color: $crimson; text-style: bold; }
#help-overlay .overridden { color: $paper-dim; text-style: italic; }

#cmdline            { background: $ink-raised; border: tall $crimson; }
#cmdline .cmd       { color: $paper; }
#cmdline .keyhint   { color: $crimson; }
#cmdline .match     { text-style: bold; }

/* ── log ───────────────────────────────────────────────── */
.log-error { color: $crimson; }
.log-warn  { color: $amber; }
.log-info  { color: $paper-dim; }
.log-ok    { color: $sage; }
